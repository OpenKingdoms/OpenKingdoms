#ifndef TAK_BUILD_STAMP_H
#define TAK_BUILD_STAMP_H

/* Generated by CMake from cmake/tak_build_stamp.h.in. Do not edit.
 *
 * The version from the top level project() plus the commit the build
 * came from. A save records this. It is never a reason to refuse a
 * load, because refusing every save on every release is worse for the
 * player than the small risk the state hash already catches. It is
 * what turns a bug report into a bisect.
 *
 * The stamp is taken when CMake configures, so a build that has not
 * reconfigured since the last commit carries the earlier commit. */

#define TAK_ENGINE_VERSION "@PROJECT_VERSION@"
#define TAK_ENGINE_COMMIT  "@TAK_GIT_DESCRIBE@"
#define TAK_ENGINE_BUILD   "@PROJECT_VERSION@+@TAK_GIT_DESCRIBE@"

#endif /* TAK_BUILD_STAMP_H */
